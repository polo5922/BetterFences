<v:DesktopWindow x:Class="BetterFences.Views.FolderIconWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:v="clr-namespace:BetterFences.Views"
                 Title="BetterFences"
                 SizeToContent="WidthAndHeight"
                 FontFamily="{StaticResource UiFont}">
    <!-- Fond quasi transparent pour que toute la zone réagisse à la souris -->
    <StackPanel x:Name="Root" Width="100" Margin="4" Background="#01000000" Cursor="Hand"
                AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop"
                MouseLeftButtonDown="OnMouseDown" MouseRightButtonUp="OnRightClick"
                ToolTip="{Binding Name}">
        <Grid x:Name="Tile" Width="74" Height="74" Margin="0,6,0,0" HorizontalAlignment="Center">
            <Border CornerRadius="24" Background="{Binding BackgroundBrush}" Effect="{StaticResource CardShadow}"/>
            <Border x:Name="Outline" CornerRadius="24" BorderBrush="{StaticResource Outline}" BorderThickness="1"/>
            <ItemsControl ItemsSource="{Binding PreviewItems}" Margin="11" IsHitTestVisible="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="2" Columns="2"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Image Source="{Binding Icon}" Width="22" Height="22" Margin="2"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
        <TextBlock x:Name="NameLabel" Text="{Binding Name}" Margin="2,6,2,4" FontSize="12" TextAlignment="Center"
                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="32"
                   Foreground="White" Effect="{StaticResource TextShadow}"/>
    </StackPanel>
</v:DesktopWindow>
