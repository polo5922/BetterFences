<v:DesktopWindow x:Class="BetterFences.Views.FolderPanelWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:v="clr-namespace:BetterFences.Views"
                 Title="BetterFences">
    <Grid Margin="8">
        <!-- Couche d'ombre séparée pour garder un texte net -->
        <Border CornerRadius="24" Background="{Binding BackgroundBrush}" Effect="{StaticResource CardShadow}"/>
        <Border CornerRadius="24" BorderBrush="{StaticResource Outline}" BorderThickness="1">
            <v:FolderContentView x:Name="ContentView"/>
        </Border>
        <Thumb x:Name="ResizeGrip" Width="18" Height="18" Margin="0,0,4,4" Cursor="SizeNWSE"
               HorizontalAlignment="Right" VerticalAlignment="Bottom"
               DragDelta="OnResize" DragCompleted="OnResizeDone">
            <Thumb.Template>
                <ControlTemplate TargetType="Thumb">
                    <Grid Background="Transparent">
                        <Path Data="M 12,2 L 2,12 M 12,7 L 7,12" Stroke="#60FFFFFF" StrokeThickness="1.4"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </ControlTemplate>
            </Thumb.Template>
        </Thumb>
    </Grid>
</v:DesktopWindow>
