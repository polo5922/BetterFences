<Window x:Class="BetterFences.Views.PopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:BetterFences.Views"
        Title="BetterFences"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize"
        SizeToContent="Height" WindowStartupLocation="Manual" Opacity="0">
    <Grid x:Name="Root" Margin="14" RenderTransformOrigin="0.5,0">
        <Grid.RenderTransform>
            <ScaleTransform x:Name="Scale" ScaleX="0.9" ScaleY="0.9"/>
        </Grid.RenderTransform>
        <Border CornerRadius="28" Background="{Binding BackgroundBrush}" Effect="{StaticResource CardShadow}"/>
        <Border CornerRadius="28" BorderBrush="{StaticResource Outline}" BorderThickness="1">
            <v:FolderContentView x:Name="ContentView" MaxHeight="560" Margin="0,4,0,0"/>
        </Border>
    </Grid>
</Window>
