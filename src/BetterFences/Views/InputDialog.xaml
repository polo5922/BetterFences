<Window x:Class="BetterFences.Views.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BetterFences" Width="380" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen" FontFamily="{StaticResource UiFont}">
    <Border Margin="12" CornerRadius="22" Background="#FA1E2028" BorderBrush="{StaticResource Outline}" BorderThickness="1"
            Padding="22,18" Effect="{StaticResource CardShadow}" MouseLeftButtonDown="OnDrag">
        <StackPanel>
            <TextBlock x:Name="TitleText" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"
                       TextWrapping="Wrap" Margin="0,0,0,14"/>
            <Border CornerRadius="10" Background="#14FFFFFF" BorderBrush="{StaticResource Outline}" BorderThickness="1">
                <TextBox x:Name="Input" Background="Transparent" BorderThickness="0" Padding="8,7" FontSize="14"
                         Foreground="{StaticResource TextPrimary}" CaretBrush="White"/>
            </Border>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Content="Annuler" IsCancel="True" Click="OnCancel" Margin="0,0,8,0"/>
                <Button Content="OK" IsDefault="True" Click="OnOk"/>
            </StackPanel>
        </StackPanel>
    </Border>
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="16" Padding="18,6" Background="#22FFFFFF">
                            <ContentPresenter HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsDefault" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#4F7CFF"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
</Window>
